{
  "name": "della-climate",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
